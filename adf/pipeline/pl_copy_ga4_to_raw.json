{
	"name": "pl_copy_ga4_to_raw",
	"properties": {
		"description": "Copies the five GA4 reports from the Data Lake (raw/ga4) into the raw tables in Azure SQL.\n",
		"activities": [
			{
				"name": "copy_daily_traffic_json_to_sql",
				"description": "Loads the GA4 daily traffic report from the JSON file (raw/ga4/daily_traffic) into raw.ga4_daily_traffic",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "DELETE FROM raw.ga4_daily_traffic",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_json_lake",
						"type": "DatasetReference",
						"parameters": {
							"folder_path": "ga4/daily_traffic",
							"file_name": {
								"value": "@concat('daily_traffic_', pipeline().parameters.load_date, '.json')\n",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sql_table",
						"type": "DatasetReference",
						"parameters": {
							"schema_name": "raw",
							"table_name": "ga4_daily_traffic"
						}
					}
				]
			},
