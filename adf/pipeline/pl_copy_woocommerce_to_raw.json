								}
							},
							{
								"source": {
									"path": "$['name']"
								},
								"sink": {
									"name": "name",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['slug']"
								},
								"sink": {
									"name": "slug",
									"type": "String"
								}
